# Neon PostgreSQL connection string. Use a separate development database.
DATABASE_URL=
# Local: http://localhost:3000; production: https://drewspets.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# Independent random secrets, each >=32 characters. openssl rand -base64 48
BETTER_AUTH_SECRET=
BOOKING_TOKEN_SECRET=
ADMIN_EMAIL=
# Use only for bun run admin:create; remove immediately afterward.
ADMIN_BOOTSTRAP_PASSWORD=
# Optional email; queued messages remain visible in the admin dashboard until configured.
RESEND_API_KEY=
EMAIL_FROM=
CRON_SECRET=
# Optional Stripe; configure signed webhook before enabling real payment.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional public contact details, founder image, and analytics.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_VERCEL_ANALYTICS=false
NEXT_PUBLIC_GA_ID=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
