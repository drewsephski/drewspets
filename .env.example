# Required canonical origin; use http://localhost:3000 for local development.
NEXT_PUBLIC_SITE_URL=https://drewspets.com
# Required for forms. EMAIL_FROM must use a verified Resend domain.
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_EMAIL=
# Optional storage and persistent rate limiting. Existing migrations must be applied.
DATABASE_URL=
# Optional SMS alerts to Drew. Require DATABASE_URL and an approved SMS sender.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ADMIN_SMS_TO=
# Public fallback contact details and analytics.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_VERCEL_ANALYTICS=true
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_REVIEW_URL=
# Hosted Stripe Payment Link for existing invoices and custom payments.
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=
# Server-only payment SMS webhook; use the live link's plink_ ID and its own signing secret.
STRIPE_PAYMENT_LINK_ID=
STRIPE_PAYMENT_WEBHOOK_SECRET=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
